// A button with a different rectangle in each of its states, and actions
// compiled by Rascal.
Swf(
    version: 10,
    tags: [
        FileAttributes(),

        // 100x40 pixel rectangles in red, green and blue.
        DefineShape(
            id: 1,
            bounds: (x_min: 0, x_max: 100, y_min: 0, y_max: 40),
            fill_styles: [Solid(0xCC3333)],
            records: [
                StyleChange(fill_style_1: 1),
                StraightEdge(dx: 100),
                StraightEdge(dy: 40),
                StraightEdge(dx: -100),
                StraightEdge(dy: -40),
            ],
        ),
        DefineShape(
            id: 2,
            bounds: (x_min: 0, x_max: 100, y_min: 0, y_max: 40),
            fill_styles: [Solid(0x33CC33)],
            records: [
                StyleChange(fill_style_1: 1),
                StraightEdge(dx: 100),
                StraightEdge(dy: 40),
                StraightEdge(dx: -100),
                StraightEdge(dy: -40),
            ],
        ),
        DefineShape(
            id: 3,
            bounds: (x_min: 0, x_max: 100, y_min: 0, y_max: 40),
            fill_styles: [Solid(0x3333CC)],
            records: [
                StyleChange(fill_style_1: 1),
                StraightEdge(dx: 100),
                StraightEdge(dy: 40),
                StraightEdge(dx: -100),
                StraightEdge(dy: -40),
            ],
        ),

        DefineButton(
            id: 4,
            records: [
                (states: [Up, HitTest], character: 1, depth: 1),
                (states: [Over], character: 2, depth: 1),
                (
                    states: [Down],
                    character: 3,
                    depth: 1,
                    matrix: (
                        translate_x: 1,        // in pixels
                        translate_y: 1,
                    ),
                ),
            ],
            actions: Rascal(r#"trace("clicked");"#),
        ),

        PlaceObject2(
            depth: 1,
            character: 4,                      // places the button on the stage
            matrix: (translate_x: 225, translate_y: 180),
        ),
        ShowFrame,
        End,
    ],
)
