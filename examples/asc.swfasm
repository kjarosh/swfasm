// ABC bytecode compiled by asc from ActionScript 3.
Swf(
    version: 10,
    tags: [
        FileAttributes(action_script_3: true),
        DoAbc(Asc(r#"trace("hello from ActionScript");"#)),

        // The same, with the script written as a field.
        DoAbc(Asc(source: r#"
            var greeting:String = "hello";
            trace(greeting + " from a field");
        "#)),

        // Paths of files are relative to the directory of the source file.
        // asc compiles only the files it is given, so the files with the
        // classes that the main script uses are listed in `scripts`, and are
        // compiled into the same ABC file.
        DoAbc2(
            lazy_initialize: true,
            name: "main",
            data: Asc(file: "asc/Main.as", scripts: ["asc/pkg/Greeter.as"]),
        ),

        // Debug info can be included, and optimizations turned off.
        DoAbc(Asc(
            source: r#"trace("hello with debug info");"#,
            optimize: false,
            debug: true,
        )),

        SymbolClass([(character: 0, name: "Main")]),
        ShowFrame,
        End,
    ],
)
