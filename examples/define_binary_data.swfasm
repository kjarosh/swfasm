// Binary data, inline or loaded from a file.
Swf(
    version: 10,
    tags: [
        FileAttributes(action_script_3: true),
        DefineBinaryData(id: 1, data: InlineBytes("de ad be ef")),

        // Paths are relative to the directory of the source file.
        DefineBinaryData(id: 2, data: File("define_binary_data.bin")),

        ShowFrame,
        End,
    ],
)
