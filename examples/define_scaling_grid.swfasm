// A sprite with a scaling grid, placed stretched to three times its width.
Swf(
    version: 10,
    stage: (width: 400, height: 200),
    tags: [
        FileAttributes(),

        // DefineShape, a 100x40 pixel red rectangle.
        Raw(code: 2, data: InlineBytes([
            "01 00",                               // ID
            "60 00 3e 80 00 19 00",                // bounds
            "01 00 cc 33 33",                      // fill styles: solid red
            "00",                                  // line styles: none
            "10",                                  // fill and line style bit counts
            "13 d0 fa 1c ac 83 a2 0c 39 67 00 00", // the rectangle
        ])),

        DefineSprite(id: 2, tags: [
            PlaceObject2(depth: 1, character: 1),
            ShowFrame,
            End,
        ]),

        DefineScalingGrid(character: 2, splitter: (x: 20, y: 10, width: 60, height: 20)),

        PlaceObject2(
            depth: 1,
            character: 2,
            matrix: (scale_x: 3, translate_x: 50, translate_y: 80),
        ),
        ShowFrame,
        End,
    ],
)
