// A sprite (movie clip) with its own timeline, placed on the stage.
Swf(
    version: 10,
    tags: [
        FileAttributes(),
        DefineSprite(
            id: 1,
            num_frames: 2,          // default: the number of ShowFrame tags in the sprite
            tags: [                 // the sprite's timeline
                DoAction(InlineBytes([
                    "96 07 00 00 68 65 6c 6c 6f 00", // Push "hello"
                    "26",                            // Trace
                    "00",                            // End
                ])),
                ShowFrame,
                ShowFrame,
                End,                // the tag list is not terminated automatically
            ],
        ),

        PlaceObject2(depth: 1, character: 1), // places the sprite on the stage

        ShowFrame,
        End,
    ],
)
