// A font with three glyphs, shown by a text.
Swf(
    version: 10,
    tags: [
        FileAttributes(),
        SetBackgroundColor("#FFFFFF"),

        DefineFont(
            id: 1,
            glyphs: [
                // A square.
                (records: [
                    StyleChange(move_to: (x: 0, y: -40), fill_style_1: 1),
                    StraightEdge(dx: 40),          // deltas are in pixels
                    StraightEdge(dy: 40),
                    StraightEdge(dx: -40),
                    StraightEdge(dy: -40),
                ]),
                // A triangle.
                (records: [
                    StyleChange(move_to: (x: 0, y: 0), fill_style_1: 1),
                    StraightEdge(dx: 20, dy: -40),
                    StraightEdge(dx: 20, dy: 40),
                    StraightEdge(dx: -40),
                ]),
                // A lens, made of 2 curves.
                (records: [
                    StyleChange(move_to: (x: 0, y: -20), fill_style_1: 1),
                    CurvedEdge(control_dx: 20, control_dy: -20, anchor_dx: 20, anchor_dy: 20),
                    CurvedEdge(control_dx: -20, control_dy: 20, anchor_dx: -20, anchor_dy: -20),
                ]),
            ],
        ),

        // DefineText, with the glyphs 0, 1, 2 and 0 of the font in blue.
        Raw(code: 11, data: InlineBytes([
            "02 00",                               // ID
            "68 00 1f 41 ce 00 00 00",             // bounds
            "00",                                  // matrix: identity
            "02 0b",                               // glyph and advance bits
            "8f 01 00 00 00 ff 00 00 00 00 20 03", // style: font, color, offsets, height
            "04 1f 42 fa 27 d0 3e 80",             // 4 glyphs, 50 pixels apart
            "00",                                  // end
        ])),

        PlaceObject2(
            depth: 1,
            character: 2,                          // places the text on the stage
            matrix: (translate_x: 175, translate_y: 220),
        ),
        ShowFrame,
        End,
    ],
)
