// Two buttons whose tab order is the opposite of their depth order.
Swf(
    version: 10,
    stage: (width: 300, height: 200),
    tags: [
        FileAttributes(),

        // DefineShape, a 100x40 pixel red rectangle, which both buttons use.
        Raw(code: 2, data: InlineBytes([
            "01 00",                               // ID
            "60 00 3e 80 00 19 00",                // bounds
            "01 00 cc 33 33",                      // fill styles: solid red
            "00",                                  // line styles: none
            "10",                                  // fill and line style bit counts
            "13 d0 fa 1c ac 83 a2 0c 39 67 00 00", // the rectangle
        ])),

        DefineButton(
            id: 2,
            records: [(states: [Up, HitTest], character: 1, depth: 1)],
            actions: InlineBytes("00"),
        ),
        DefineButton(
            id: 3,
            records: [(states: [Up, HitTest], character: 1, depth: 1)],
            actions: InlineBytes("00"),
        ),

        PlaceObject2(depth: 1, character: 2, matrix: (translate_x: 100, translate_y: 40)),
        PlaceObject2(depth: 2, character: 3, matrix: (translate_x: 100, translate_y: 120)),

        SetTabIndex(depth: 1, tab_index: 2),
        SetTabIndex(depth: 2, tab_index: 1),

        ShowFrame,
        End,
    ],
)
